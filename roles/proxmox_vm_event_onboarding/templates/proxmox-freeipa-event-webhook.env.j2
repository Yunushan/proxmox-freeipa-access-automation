PFA_WEBHOOK_BIND="{{ proxmox_vm_event_webhook_bind }}"
PFA_WEBHOOK_PORT={{ proxmox_vm_event_webhook_port | int }}
PFA_WEBHOOK_PATH="{{ proxmox_vm_event_webhook_path }}"
PFA_HEALTH_PATH="{{ proxmox_vm_event_webhook_health_path }}"
PFA_WEBHOOK_TOKEN="{{ proxmox_vm_event_webhook_token }}"
PFA_ALLOWED_PHASES="{{ proxmox_vm_event_allowed_phases | join(',') }}"
PFA_DEBOUNCE_SECONDS={{ proxmox_vm_event_webhook_debounce_seconds | int }}
PFA_PRE_RUN_DELAY_SECONDS={{ proxmox_vm_event_webhook_pre_run_delay_seconds | int }}
PFA_RETRY_COUNT={{ proxmox_vm_event_webhook_retry_count | int }}
PFA_RETRY_DELAY_SECONDS={{ proxmox_vm_event_webhook_retry_delay_seconds | int }}
PFA_REPO_DIR="{{ proxmox_vm_event_webhook_effective_repo_dir }}"
PFA_PLAYBOOK="{{ proxmox_vm_event_webhook_playbook }}"
PFA_INVENTORY="{{ proxmox_vm_event_webhook_effective_inventory }}"
PFA_ANSIBLE_PLAYBOOK_BIN="{{ proxmox_vm_event_webhook_ansible_playbook_bin }}"
PFA_ANSIBLE_EXTRA_ARGS="{{ proxmox_vm_event_webhook_ansible_extra_args }}"
{% if proxmox_vm_event_webhook_tls_certfile | default('', true) | string | trim | length > 0 %}
PFA_TLS_CERTFILE="{{ proxmox_vm_event_webhook_tls_certfile }}"
{% endif %}
{% if proxmox_vm_event_webhook_tls_keyfile | default('', true) | string | trim | length > 0 %}
PFA_TLS_KEYFILE="{{ proxmox_vm_event_webhook_tls_keyfile }}"
{% endif %}
