# Copy to /etc/default/proxmox-freeipa-event-webhook on the Ansible controller.

PFA_WEBHOOK_BIND=0.0.0.0
PFA_WEBHOOK_PORT=8085
PFA_WEBHOOK_PATH=/hooks/proxmox-vm-event
PFA_HEALTH_PATH=/healthz
PFA_WEBHOOK_TOKEN=CHANGE_ME
PFA_ALLOWED_PHASES=post-start,post-migrate
PFA_DEBOUNCE_SECONDS=5
PFA_PRE_RUN_DELAY_SECONDS=20
PFA_RETRY_COUNT=2
PFA_RETRY_DELAY_SECONDS=30
PFA_REPO_DIR=/opt/ansible/proxmox-freeipa-access-automation
PFA_PLAYBOOK=playbooks/proxmox-vm-event.yml
PFA_INVENTORY=inventories/production/hosts.yml
PFA_ANSIBLE_PLAYBOOK_BIN=/usr/bin/ansible-playbook
PFA_ANSIBLE_EXTRA_ARGS=--vault-id freeipa@/etc/proxmox-freeipa-access-automation/freeipa.vault-pass --vault-id proxmox@/etc/proxmox-freeipa-access-automation/proxmox.vault-pass
# Optional direct TLS on the webhook listener.
# PFA_TLS_CERTFILE=/etc/proxmox-freeipa-access-automation/webhook.crt
# PFA_TLS_KEYFILE=/etc/proxmox-freeipa-access-automation/webhook.key
