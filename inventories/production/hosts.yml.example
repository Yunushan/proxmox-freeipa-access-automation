---
all:
  vars:
    ansible_user: root
  children:
    ipa_servers:
      hosts:
        ipa01.example.com:
          ansible_host: 192.0.2.21
    proxmox_primary:
      vars:
        # Optional: use a regular sudo-capable user for Proxmox instead of root.
        # ansible_user: automation-user
        # ansible_become_method: sudo
        # ansible_become_password: "{{ vault_proxmox_become_password }}"
      hosts:
        pve01.example.com:
          ansible_host: 192.0.2.11
    linux_ipa_clients:
      hosts:
        # This is the declarative source group. The playbooks build
        # linux_ipa_clients_runtime from these entries, manual definitions,
        # and optional Proxmox discovery.
        # Option 1: static FQDN inventory entries.
        rocky-app-01.example.com:
          ansible_host: 192.0.2.101
        # Option 2: IP-only aliases also work if the guest's final hostname can
        # be resolved with hostname -f during the play.
        vm-102:
          ansible_host: 192.0.2.102
        # Option 3: remove these entries entirely and use linux_ipa_client_hosts
        # or Proxmox VM discovery from group_vars/all/30-linux-clients.yml instead.
    windows_qemu_guest_agent_clients:
      hosts:
        # Optional: only used when you want this repository to install QEMU
        # Guest Agent on reachable Windows guests. This does not enroll or
        # otherwise manage Windows identity.
        # windows-guest-01.example.com:
        #   ansible_host: 192.0.2.150
        #   ansible_connection: winrm
        #   ansible_user: Administrator
        #   ansible_password: "{{ vault_windows_admin_password }}"
        #   ansible_port: 5986
        #   ansible_winrm_transport: ntlm
        #   ansible_winrm_server_cert_validation: ignore
    windows_management_clients:
      hosts:
        # Optional: Windows 10/11 and Windows Server guests managed by the
        # separate Windows workflow. These hosts can also be members of
        # windows_qemu_guest_agent_clients when you want the QEMU Guest Agent
        # helper path on the same VM.
        # windows-server-01.ad.example.com:
        #   ansible_host: 192.0.2.160
        #   ansible_connection: winrm
        #   ansible_user: Administrator
        #   ansible_password: "{{ vault_windows_admin_password }}"
        #   ansible_port: 5986
        #   ansible_winrm_transport: ntlm
        #   ansible_winrm_server_cert_validation: ignore
        #   windows_domain_membership_hostname: APP-SRV-01
